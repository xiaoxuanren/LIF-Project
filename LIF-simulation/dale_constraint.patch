+    def effective_W(self):
+        """Return candidate weights [n_neurons, K] after any Dale sign tying.
+
+        With ``dale=False`` this is the raw ``W``. With ``dale=True`` every edge
+        is ``sign[presynaptic] * softplus(magnitude)``: the magnitude is per-edge,
+        but the sign is shared across all of a presynaptic neuron's targets, so
+        Dale's law holds exactly (no neuron is excitatory onto some targets and
+        inhibitory onto others).
+        """
+        if not self.dale:
+            return self.W
+        sign = torch.tanh(self.presyn_sign_logit)        # [n_neurons], tied per presynaptic neuron
+        sign_jk = sign[self.neighbor_index_buffer]       # [n_neurons, K]
+        return sign_jk * F.softplus(self.W)
+
